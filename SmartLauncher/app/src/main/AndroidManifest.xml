<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 查询已安装的 launcher 应用需要该权限（Android 11+ 包可见性限制） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIEW_SYSTEM_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartLauncher">

        <!-- 主页 Launcher：可被设为默认桌面 -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 全部已安装应用列表 -->
        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.SmartLauncher.AllApps" />

    </application>

</manifest>
