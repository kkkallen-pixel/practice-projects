<?xml version="1.0" encoding="utf-8"?>
<!-- 底部系统功能方块背景：圆角卡片，聚焦时高亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/tile_focused_fill" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="@color/focus_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/tile_fill" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
